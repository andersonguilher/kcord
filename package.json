{
  "name": "kcord",
  "productName": "KCord",
  "version": "0.1.20",
  "description": "Cliente de comunidades, voz e transmissão do KCord",
  "author": "Kafly",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsx watch --env-file-if-exists=.env server/index.ts\"",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc -b",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:chat-store": "tsx scripts/chat-store-smoke.ts",
    "test:link-preview": "tsx scripts/link-preview-smoke.ts",
    "test:client-reports": "tsx scripts/client-reports-smoke.ts",
    "test:voice-permissions": "tsx scripts/voice-permission-smoke.ts",
    "test:session-afk": "node scripts/session-afk-smoke.mjs",
    "test:voice-eq": "node scripts/voice-eq-smoke.mjs",
    "test:state-migration": "node scripts/state-migration-smoke.mjs",
    "test:desktop-hook": "electron scripts/desktop-hook-smoke.cjs",
    "test:ptt-hook": "node scripts/ptt-hook-smoke.cjs",
    "test:desktop-package": "node scripts/desktop-package-smoke.cjs",
    "test:instance-lock": "node scripts/instance-lock-smoke.cjs",
    "desktop": "electron .",
    "desktop:deps": "npm install --prefix electron",
    "desktop:native": "cargo build --release --locked --manifest-path native/app-audio/Cargo.toml --config \"target.x86_64-pc-windows-msvc.rustflags=['-C','target-feature=+crt-static']\"",
    "desktop:pack": "npm run desktop:deps && npm run desktop:native && electron-builder --dir --win",
    "desktop:dist": "npm run desktop:deps && npm run desktop:native && electron-builder --win nsis",
    "desktop:web-dist": "npm run desktop:deps && npm run desktop:native && electron-builder --win nsis-web --config.directories.output=desktop-web-dist",
    "test:desktop-web-package": "node scripts/desktop-web-package-smoke.cjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test:tauri-package": "node scripts/tauri-package-smoke.cjs",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:ui": "node scripts/ui-smoke.mjs"
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "livekit-server-sdk": "^2.19.3",
    "multer": "^2.4.0",
    "socket.io": "^4.8.4",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@tauri-apps/cli": "^2.9.4",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "happy-dom": "^21.0.4",
    "koffi": "^2.16.3",
    "playwright-core": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.4",
    "typescript": "^7.0.2",
    "uiohook-napi": "^1.5.5",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "br.com.kafly.kcord",
    "productName": "KCord",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en-US",
      "pt-BR"
    ],
    "directories": {
      "app": "electron",
      "output": "desktop-dist"
    },
    "files": [
      "**/*",
      "!node_modules/**/*.map",
      "!node_modules/uiohook-napi/build/**",
      "!node_modules/uiohook-napi/src/**",
      "!node_modules/uiohook-napi/libuiohook/**",
      "!node_modules/uiohook-napi/prebuilds/darwin-arm64/**",
      "!node_modules/uiohook-napi/prebuilds/darwin-x64/**",
      "!node_modules/uiohook-napi/prebuilds/linux-arm64/**",
      "!node_modules/uiohook-napi/prebuilds/linux-loong64/**",
      "!node_modules/uiohook-napi/prebuilds/linux-x64/**",
      "!node_modules/uiohook-napi/prebuilds/win32-arm64/**",
      "!node_modules/koffi/build/koffi/darwin_arm64/**",
      "!node_modules/koffi/build/koffi/darwin_x64/**",
      "!node_modules/koffi/build/koffi/freebsd_arm64/**",
      "!node_modules/koffi/build/koffi/freebsd_ia32/**",
      "!node_modules/koffi/build/koffi/freebsd_x64/**",
      "!node_modules/koffi/build/koffi/linux_arm64/**",
      "!node_modules/koffi/build/koffi/linux_armhf/**",
      "!node_modules/koffi/build/koffi/linux_ia32/**",
      "!node_modules/koffi/build/koffi/linux_loong64/**",
      "!node_modules/koffi/build/koffi/linux_riscv64d/**",
      "!node_modules/koffi/build/koffi/linux_x64/**",
      "!node_modules/koffi/build/koffi/musl_arm64/**",
      "!node_modules/koffi/build/koffi/musl_x64/**",
      "!node_modules/koffi/build/koffi/openbsd_ia32/**",
      "!node_modules/koffi/build/koffi/openbsd_x64/**",
      "!node_modules/koffi/build/koffi/win32_arm64/**",
      "!node_modules/koffi/build/koffi/win32_ia32/**",
      "!node_modules/koffi/{src,vendor,doc}/**"
    ],
    "extraResources": [
      {
        "from": "build/icon-v2.png",
        "to": "build/icon-v2.png"
      },
      {
        "from": "build/icon-v2.ico",
        "to": "build/icon-v2.ico"
      },
      {
        "from": "native/app-audio/target/release/kcord-app-audio.exe",
        "to": "bin/kcord-app-audio.exe"
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://kafcord.kafly.com.br/downloads/"
      }
    ],
    "win": {
      "icon": "build/icon-v2.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "KCord-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KCord"
    },
    "nsisWeb": {
      "artifactName": "KCord-Web-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KCord"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andersonguilher/kcord.git"
  },
  "homepage": "https://github.com/andersonguilher/kcord",
  "bugs": {
    "url": "https://github.com/andersonguilher/kcord/issues"
  }
}
