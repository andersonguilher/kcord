# LiveKit SFU for KCord (docs/LIVEKIT.md). Copy to livekit.yaml, fill in the placeholders and
# chmod 600. Signalling is reached through nginx at /livekit/rtc; the admin API listens on
# localhost only and is used by the KCord server.
port: 7880
bind_addresses:
  - 127.0.0.1
rtc:
  tcp_port: 7881             # fallback when UDP is blocked
  port_range_start: 50000    # media; keep the range narrow so it is easy to open
  port_range_end: 50100
  node_ip: <SERVER_PUBLIC_IP>
keys:
  <API_KEY>: <API_SECRET>    # at least 32 random characters
room:
  empty_timeout: 60
logging:
  level: info
