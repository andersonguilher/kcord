# Discord Developer Portal > General Information
DISCORD_CLIENT_ID=

# Discord Developer Portal > OAuth2. Keep this value only in your local .env.
DISCORD_CLIENT_SECRET=

# Discord Developer Portal > Bot. Keep this value only in your local .env.
DISCORD_BOT_TOKEN=

# Create a long random local value used to sign Kafcord sessions.
SESSION_SECRET=

# Immutable Discord user ID allowed to import community models and members.
KAFCORD_OWNER_DISCORD_ID=

# Sessions are persisted server-side and renewed for 30 days while in use.

# Add this exact URL under Discord OAuth2 > Redirects.
DISCORD_REDIRECT_URI=http://localhost:3001/auth/discord/callback
HOST=0.0.0.0
PORT=3001

# SQLite chat database. Defaults to data/kafcord.sqlite.
# Keep this path in persistent/shared storage when deploying immutable releases.
KAFCORD_CHAT_DATABASE_PATH=data/kafcord.sqlite

# Persistent link-card metadata and images. Defaults to data/link-preview-cache.
KAFCORD_LINK_PREVIEW_CACHE_PATH=data/link-preview-cache

# Folder served at /downloads for KCord desktop installers and update metadata.
KCORD_DOWNLOADS_DIR=downloads
